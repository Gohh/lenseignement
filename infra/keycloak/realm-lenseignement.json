{
  "realm": "lenseignement",
  "displayName": "L'Enseignement (développement)",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "resetPasswordAllowed": true,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "waitIncrementSeconds": 60,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "internationalizationEnabled": true,
  "supportedLocales": ["fr"],
  "defaultLocale": "fr",
  "passwordPolicy": "length(12) and notUsername",
  "roles": {
    "realm": [
      {
        "name": "apprenant",
        "description": "Apprenant (mineur ou adulte)"
      },
      {
        "name": "parent",
        "description": "Parent ou tuteur légal"
      },
      {
        "name": "enseignant",
        "description": "Enseignant ou formateur"
      },
      {
        "name": "alphabetiseur",
        "description": "Alphabétiseur"
      },
      {
        "name": "chef-etablissement",
        "description": "Chef d'établissement (directeur ou directrice)"
      },
      {
        "name": "referent-pedagogique",
        "description": "Révise et approuve les contenus"
      },
      {
        "name": "admin-plateforme",
        "description": "Administration technique (MFA obligatoire)"
      }
    ]
  },
  "clients": [
    {
      "clientId": "lenseignement-web",
      "name": "Portail web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-only-web-secret-change-me",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:3000/auth/callback"],
      "webOrigins": ["http://localhost:3000"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/",
        "frontchannel.logout": "false"
      },
      "protocolMappers": [
        {
          "name": "audience-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "lenseignement-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ],

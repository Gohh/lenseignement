# Copier en .env et adapter. Valeurs de DÉVELOPPEMENT uniquement : ne jamais réutiliser en production.
NODE_ENV=development

# API
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# PostgreSQL (docker-compose)
POSTGRES_USER=lenseignement
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_DB=lenseignement
DATABASE_URL=postgresql://lenseignement:change-me-dev-only@localhost:5432/lenseignement

# Redis
REDIS_URL=redis://localhost:6379

# Stockage objet S3-compatible (MinIO)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=lenseignement
S3_SECRET_KEY=change-me-dev-only
S3_BUCKET=lenseignement-dev

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
